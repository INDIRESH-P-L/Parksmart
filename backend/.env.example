# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database mode ───────────────────────────────────────────────────────────
# Leave the SUPABASE_* values as placeholders to run on the built-in LOCAL
# database (zero setup, seeded demo data, persists to backend/.local-db.json).
# Fill in real Supabase creds to use Supabase. Optional override:
#   USE_LOCAL_DB=true   → force the local database
#   USE_LOCAL_DB=false  → force Supabase
# USE_LOCAL_DB=

# ─── Supabase (Dashboard → Project Settings → API) ───────────────────────────
# SERVICE ROLE key stays on the server ONLY — it bypasses RLS. Never ship it
# to a browser or mobile app.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=paste-your-service-role-key-here
SUPABASE_ANON_KEY=paste-your-anon-public-key-here

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate strong values, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
# Separate secret for signing QR ticket payloads (so leaking one doesn't leak both)
QR_SECRET=replace-with-a-different-long-random-string

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated allow-list of browser origins. Never use *.
CORS_ORIGIN=http://localhost:5173

# ─── Rate limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_AUTH=20
RATE_LIMIT_MAX_BOOKING=10
